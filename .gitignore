.DS_Store

# Local Python environment
venv/
.venv/
__pycache__/
*.pyc

# Local Google/YouTube credentials. Store these in GitHub Actions secrets.
client_secrets.json
token.json

# Generated media
outputs/*
!outputs/.gitkeep

# Standalone YouTube MCP local artifacts
*.egg-info/
.pytest_cache/
youtube-mcp/.venv/
read-token.json
write-token.json

# Private local analytics snapshots (never deploy channel analytics)
experiments/*/baseline.json
experiments/*/inventory.json
experiments/*/report*.json
